def attendance_percentage(attended, total):
    return (attended / total) * 100


def classes_needed(attended, total, target=75):
    current_percent = (attended / total) * 100

    if current_percent >= target:
        return 0

    # x = required attended classes
    required = (target * total) / 100
    return int(required - attended + 1)


print("===== ATTENDANCE CALCULATOR =====")

total_classes = int(input("Enter Total Classes: "))
attended_classes = int(input("Enter Attended Classes: "))

percent = attendance_percentage(attended_classes, total_classes)

print(f"\nAttendance Percentage: {percent:.2f}%")

if percent >= 75:
    print("Status: Eligible for Exams")
else:
    needed = classes_needed(attended_classes, total_classes)
    print("Status: Not Eligible for Exams")
    print(f"Need to attend at least {needed} more classes to reach 75%")
